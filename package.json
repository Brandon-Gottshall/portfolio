{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.2",
  "engines": {
    "node": ">=24 <26"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "lint": "bun run lint:eslint && bun run lint:ts",
    "lint:eslint": "eslint --ext ts,tsx,js,jsx .",
    "lint:ts": "tsc --noEmit --project tsconfig.json",
    "watch": "tsc --watch --noEmit --project './tsconfig.json' --preserveWatchOutput",
    "update-github-stats": "bun run scripts/update-github-stats.ts",
    "prepare": "husky install",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "clean:ts": "rm -rf node_modules/.cache/typescript/",
    "clean": "bun run clean:ts",
    "clear-cache": "rm -rf .next/cache && rm -rf node_modules/.cache && bun run tsc --build --clean",
    "test:db": "bun run src/payload/connection.test.ts",
    "drizzle:generate": "drizzle-kit generate:pg",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload",
    "payload:build": "cross-env PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload build",
    "payload:generate:types": "cross-env PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload generate:types",
    "payload:migrate": "cross-env PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@payloadcms/db-postgres": "^3.31.0",
    "@payloadcms/next": "^3.31.0",
    "@payloadcms/richtext-lexical": "^3.31.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sanity/desk-tool": "^2.36.2",
    "@sanity/icons": "^3.7.0",
    "@sanity/visual-editing": "^2.13.14",
    "@svgr/webpack": "^8.1.0",
    "@types/chart.js": "^2.9.41",
    "chart.js": "^4.4.8",
    "chartjs-plugin-datalabels": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "cxs": "^6.2.0",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "framer-motion": "^12.4.10",
    "lucide-react": "^0.479.0",
    "next": "15.5.21",
    "next-themes": "^0.4.4",
    "payload": "^3.31.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-pdf": "^10.0.1",
    "react-social-icons": "^6.22.0",
    "react-text-loop-next": "^0.0.3",
    "rxjs": "7.8.1",
    "sharp": "^0.33.5",
    "styled-components": "^6.1.15",
    "svgr": "^2.0.0",
    "swr": "^2.3.4",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@portabletext/types": "^2.0.13",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.9",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.5",
    "esbuild": "^0.25.8",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "eslint-config-prettier": "^10.1.1",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "happy-dom": "20.8.9",
    "husky": "^8.0.0",
    "ignore-loader": "^0.1.2",
    "jiti": "^2.4.2",
    "lint-staged": "^15.5.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "puppeteer": "^24.15.0",
    "tailwindcss": "3",
    "ts-standard": "^12.0.2",
    "tsc-files": "^1.1.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "bash -c 'tsc --noEmit --project tsconfig.json'"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
