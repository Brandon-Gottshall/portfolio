{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "sanity": ["./node_modules/sanity/lib"],
      "sanity/cli": ["./node_modules/sanity/cli"],
      "sanity/desk": ["./node_modules/sanity/desk"],
      "sanity/structure": ["./node_modules/sanity/structure"],
      "@sanity/image-url": ["./node_modules/@sanity/image-url/lib"],
      "@sanity/types": ["./node_modules/@sanity/types"],
      "@sanity/vision": ["./node_modules/@sanity/vision"],
      "@sanity/icons": ["./node_modules/@sanity/icons/lib"],
      "next-sanity": ["./node_modules/next-sanity"],
      "next-sanity/studio": ["./node_modules/next-sanity/studio"]
    }
  },
  "watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority",
    "synchronousWatchDirectory": true,
    "excludeDirectories": [
      "**/node_modules",
      "dist",
      ".next",
      "tmp_repos",
      "Component Archive",
      "coverage",
      "build"
    ],
    "excludeFiles": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx"
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/types/external-modules.d.ts",
    "sanity-structure.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "*.js",
    "*.ts"
  ],
  "exclude": ["node_modules", ".next", "tmp_repos/**", "Component Archive/**"]
}
